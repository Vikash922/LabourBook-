<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
        <!-- Preferences contain session/auth state and profile metadata; databases contain
            Firestore's local cache. Internal CSV files contain business records. These are
            intentionally excluded; explicit CSV export and authenticated Firestore sync
            remain available without disabling backup for unrelated app-private files. -->
        <exclude domain="sharedpref" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="file" path="csv_backups"/>
</full-backup-content>
