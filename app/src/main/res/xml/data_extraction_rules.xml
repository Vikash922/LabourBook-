<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Keep session/auth state, Firestore's local cache, and internal business CSVs out
         of cloud backup and device transfer. Other app-private files remain eligible. -->
    <cloud-backup>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="file" path="csv_backups"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="file" path="csv_backups"/>
    </device-transfer>
</data-extraction-rules>
